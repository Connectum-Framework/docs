{
    "name": "@connectum/docs",
    "private": true,
    "type": "module",
    "scripts": {
        "builder:update": "node scripts/update-builder-engine.mjs",
        "builder:test": "node --test tests/builder/*.test.mjs",
        "builder:typecheck": "vue-tsc --noEmit -p tsconfig.builder.json",
        "catalog:test": "node --test tests/catalog/*.test.mjs",
        "guide:test": "node --test tests/guide/*.test.mjs",
        "navigation:typecheck": "vue-tsc --noEmit -p tsconfig.navigation.json",
        "testing-guides:verify": "node scripts/verify-testing-guides.mjs",
        "homepage:generate": "node scripts/generate-homepage-story.mjs",
        "homepage:test": "node --test tests/homepage/*.test.mjs",
        "homepage:typecheck": "vue-tsc --noEmit -p tsconfig.homepage.json",
        "quickstart:generate": "node scripts/generate-quickstart-project.mjs",
        "quickstart:verify": "node scripts/verify-quickstart.mjs",
        "quickstart:openapi": "node scripts/generate-quickstart-openapi.mjs",
        "quickstart:typecheck": "vue-tsc --noEmit -p tsconfig.quickstart.json",
        "quickstart:test": "node --test tests/quickstart/*.test.mjs",
        "validation:generate": "buf generate .vitepress/validation/example --template .vitepress/validation/buf.gen.yaml",
        "validation:typecheck": "vue-tsc --noEmit -p tsconfig.validation.json",
        "interceptors:generate": "buf generate .vitepress/interceptors/example --template .vitepress/interceptors/buf.gen.yaml",
        "interceptors:typecheck": "vue-tsc --noEmit -p tsconfig.interceptors.json",
        "openapi:generate": "buf generate .vitepress/openapi/example --template .vitepress/openapi/buf.gen.yaml",
        "openapi:base": "node scripts/generate-openapi-base.mjs",
        "openapi:inspect": "node scripts/inspect-openapi-overlay.mjs",
        "openapi:reader": "node scripts/build-openapi-reader.mjs",
        "openapi:typecheck": "vue-tsc --noEmit -p tsconfig.openapi.json",
        "docs:inventory": "node scripts/docs-inventory.mjs",
        "docs:routes": "node scripts/docs-routes.mjs --write",
        "docs:routes:check": "node scripts/docs-routes.mjs --check",
        "docs:validate": "node scripts/docs-validate.mjs",
        "docs:validate:built": "node scripts/docs-validate.mjs --built && node scripts/validate-anchors.mjs",
        "docs:validate:anchors": "node scripts/validate-anchors.mjs",
        "docs:check:package-readmes": "node scripts/check-package-readme-links.mjs",
        "docs:dev": "vitepress dev",
        "docs:build": "vitepress build",
        "docs:preview": "vitepress preview"
    },
    "packageManager": "pnpm@11.0.4+sha512.0a397165007a014ed52919a61e5f46c48b9bca88404c303ecaecc63f62def563898d3c6b8a5d5ea5811eb398cfe03ab05da1a5ce963f126d5ead4c02f93b83c3",
    "devDependencies": {
        "@braintree/sanitize-url": "^7.1.2",
        "@bufbuild/buf": "1.72.0",
        "@bufbuild/protoc-gen-es": "2.16.0",
        "@mdit/plugin-tasklist": "0.23.2",
        "@mermaid-js/layout-elk": "0.2.2",
        "@types/node": "22.20.5",
        "cytoscape": "^3.33.2",
        "cytoscape-cose-bilkent": "^4.1.0",
        "dayjs": "^1.11.20",
        "debug": "^4.4.3",
        "esbuild": "0.25.0",
        "mermaid": "^11.16.1",
        "shiki": "2.5.0",
        "typescript": "5.9.3",
        "vitepress": "^1.6.3",
        "vitepress-plugin-llms": "^1.12.1",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vue": "3.5.42",
        "vue-tsc": "3.3.13"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0",
        "@bufbuild/protovalidate": "1.3.0",
        "@connectrpc/connect": "2.3.0",
        "@connectum/auth": "1.3.0",
        "medium-zoom": "^1.1.0"
    }
}
