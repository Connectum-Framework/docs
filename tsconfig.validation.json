{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": [".vitepress/theme/components/ValidationShowcase.vue", ".vitepress/validation/showcase.data.ts", ".vitepress/validation/scenarios.ts"]
}
